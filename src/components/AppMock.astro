---
// A drawn (not screenshotted) Octavo Docs window: tabs, the Google-style
// menu bar, the one-row toolbar, an outline, a page, and margin cards. The
// chrome follows the site theme like the app does; the page stays white
// because document content never follows the theme.
---

<figure class="mock" aria-label="Octavo Docs editing a document, with a comment and a suggestion in the margin">
  <div class="titlebar" aria-hidden="true">
    <span class="lights"><i></i><i></i><i></i></span>
    <span class="tab home">Home</span>
    <span class="tab active"><b class="dot docs"></b>Q3 plan.docx</span>
    <span class="tab"><b class="dot sheets"></b>Budget.xlsx</span>
    <span class="tab hide-sm"><b class="dot slides"></b>Kickoff.pptx</span>
  </div>
  <div class="menubar" aria-hidden="true">
    <span>File</span><span>Edit</span><span>View</span><span>Insert</span><span>Format</span><span
      class="hide-sm">Tools</span
    ><span class="hide-sm">Extensions</span><span class="hide-sm">Help</span>
  </div>
  <div class="toolbar" aria-hidden="true">
    <div class="pill">
      <span class="ico">↶</span><span class="ico">↷</span><span class="sep"></span>
      <span class="field">100%</span><span class="sep"></span>
      <span class="field wide">Normal text</span><span class="sep hide-sm"></span>
      <span class="field wide hide-sm">Arial</span><span class="sep hide-sm"></span>
      <span class="ico b">B</span><span class="ico i">I</span><span class="ico u">U</span>
      <span class="ico hide-sm">A</span><span class="sep hide-sm"></span>
      <span class="ico hide-sm">≡</span><span class="ico hide-sm">☰</span>
    </div>
  </div>
  <div class="body" aria-hidden="true">
    <aside class="outline">
      <p class="o-title">Outline</p>
      <p class="o-h1 on">Q3 plan</p>
      <p class="o-h2">Goals</p>
      <p class="o-h2">Timeline</p>
      <p class="o-h2">Risks</p>
    </aside>
    <div class="canvas">
      <div class="page">
        <h4>Q3 plan</h4>
        <p class="lead">Three outcomes the team commits to this quarter.</p>
        <h5>Goals</h5>
        <p>
          Ship the new onboarding flow by the end of <del>June</del><ins>July</ins>, with the{' '}
          <mark>pricing page live the same week</mark>. Every export keeps opening cleanly in Word.
        </p>
        <span class="bar" style="width: 94%"></span>
        <span class="bar" style="width: 88%"></span>
        <span class="bar" style="width: 61%"></span>
        <h5>Timeline</h5>
        <span class="bar" style="width: 91%"></span>
        <span class="bar" style="width: 72%"></span>
      </div>
    </div>
    <div class="cards">
      <div class="card suggest">
        <div class="who"><b class="avatar a2">JL</b><span>Jun Li</span></div>
        <p>Replace <s>June</s> with <em>July</em></p>
        <div class="actions"><span class="ok">✓</span><span class="no">✕</span></div>
      </div>
      <div class="card comment">
        <div class="who"><b class="avatar a1">MK</b><span>Mara K.</span></div>
        <p>Can we tie this to the launch date?</p>
        <div class="reply">Reply…</div>
      </div>
    </div>
  </div>
</figure>

<style>
  .mock {
    --m-bar: var(--surface);
    --m-chrome: var(--surface-2);
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--m-chrome);
    box-shadow: var(--shadow);
    overflow: hidden;
    font: 400 13px/1.4 var(--sans);
    color: var(--muted);
    user-select: none;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 40px;
    padding: 0 12px;
    background: var(--m-chrome);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .lights {
    display: flex;
    gap: 7px;
    margin-right: 14px;
  }

  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line);
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 30px;
    padding: 0 14px;
    border-radius: 8px 8px 0 0;
    margin-top: 10px;
    white-space: nowrap;
  }

  .tab.active {
    background: var(--m-bar);
    color: var(--text);
    font-weight: 500;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }

  .dot.docs {
    background: var(--c-docs);
  }

  .dot.sheets {
    background: var(--c-sheets);
  }

  .dot.slides {
    background: var(--c-slides);
  }

  .menubar {
    display: flex;
    gap: 18px;
    padding: 8px 18px 2px;
    background: var(--m-bar);
    color: var(--text);
  }

  .toolbar {
    padding: 6px 12px 10px;
    background: var(--m-bar);
    border-bottom: 1px solid var(--line);
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 36px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--m-chrome);
    overflow: hidden;
  }

  .ico {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    color: var(--text);
    flex: none;
  }

  .ico.b {
    font-weight: 700;
  }

  .ico.i {
    font-style: italic;
    font-family: var(--serif);
  }

  .ico.u {
    text-decoration: underline;
  }

  .field {
    padding: 0 8px;
    color: var(--text);
    white-space: nowrap;
  }

  .field.wide {
    min-width: 92px;
  }

  .sep {
    width: 1px;
    height: 18px;
    margin: 0 4px;
    background: var(--line);
    flex: none;
  }

  .body {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) 210px;
    gap: 0;
    min-height: 360px;
  }

  .outline {
    padding: 22px 16px;
    font-size: 12.5px;
  }

  .o-title {
    font-weight: 600;
    color: var(--text);
    margin-bottom: 10px;
  }

  .outline p + p {
    margin-top: 6px;
  }

  .o-h2 {
    padding-left: 12px;
  }

  .o-h1.on {
    color: var(--accent);
    font-weight: 500;
  }

  .canvas {
    padding: 22px 0 0;
    display: flex;
    justify-content: center;
    overflow: hidden;
  }

  /* document surface: fixed paper colors in both themes */
  .page {
    width: min(100%, 480px);
    padding: 36px 44px 30px;
    background: #ffffff;
    color: #202124;
    box-shadow: 0 1px 3px rgb(0 0 0 / 18%);
    font: 400 12.5px/1.6 Arial, Helvetica, sans-serif;
  }

  .page h4 {
    font: 400 26px/1.2 Arial, Helvetica, sans-serif;
    margin: 0 0 4px;
  }

  .page .lead {
    color: #5f6368;
    margin-bottom: 14px;
  }

  .page h5 {
    font: 400 16px/1.3 Arial, Helvetica, sans-serif;
    margin: 14px 0 6px;
  }

  .page p {
    margin-bottom: 8px;
  }

  .page del {
    color: #188038;
    text-decoration-color: #188038;
  }

  .page ins {
    color: #188038;
    text-decoration: underline;
  }

  .page mark {
    background: #fde293;
    color: inherit;
    border-bottom: 2px solid #f9ab00;
  }

  .bar {
    display: block;
    height: 7px;
    margin: 9px 0;
    border-radius: 4px;
    background: #e8eaed;
  }

  .cards {
    padding: 96px 14px 0 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 6%);
    color: var(--text);
  }

  .card.comment {
    border-left: 3px solid #f9ab00;
  }

  .card.suggest {
    border-left: 3px solid #188038;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .avatar {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    font-size: 10px;
    color: #ffffff;
  }

  .avatar.a1 {
    background: #8e4ec6;
  }

  .avatar.a2 {
    background: #188038;
  }

  .card p {
    font-size: 12.5px;
  }

  .card s {
    color: var(--muted);
  }

  .actions {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .actions span {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--surface-2);
  }

  .actions .ok {
    color: var(--c-sheets);
  }

  .reply {
    margin-top: 8px;
    padding: 5px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--faint);
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1fr) 190px;
    }

    .outline {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .hide-sm {
      display: none;
    }

    .body {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .canvas {
      padding: 16px 12px 0;
    }

    .page {
      padding: 24px 22px 18px;
    }

    .cards {
      padding: 12px;
      flex-direction: row;
    }

    .card {
      flex: 1;
      min-width: 0;
    }

    .card.comment .reply {
      display: none;
    }
  }
</style>
