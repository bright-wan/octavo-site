---
const home = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={home} aria-label="Octavo home">
      <svg viewBox="0 0 64 64" aria-hidden="true"
        ><rect width="64" height="64" rx="14" fill="var(--logo)"></rect><circle
          cx="32"
          cy="32"
          r="15.6"
          fill="none"
          stroke="var(--bg)"
          stroke-width="7.8"></circle></svg
      >
      <span>Octavo</span>
    </a>
    <nav aria-label="Main">
      <a href={`${home}#editors`} class="hide-sm">Editors</a>
      <a href={`${home}privacy/`} class="hide-sm">Privacy</a>
      <a href={`${home}#download`} class="btn primary small">Download</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    font: 600 22px/1 var(--serif);
    letter-spacing: -0.01em;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand svg {
    width: 28px;
    height: 28px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 3vw, 28px);
    font-size: 15px;
  }

  nav a:not(.btn) {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:not(.btn):hover {
    color: var(--text);
  }

  .btn.small {
    min-height: 38px;
    padding: 0 18px;
    font-size: 15px;
  }

  @media (max-width: 620px) {
    .hide-sm {
      display: none;
    }
  }
</style>
